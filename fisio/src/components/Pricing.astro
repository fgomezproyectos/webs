---
import Icon from './Icon.astro';
import { pricing, ui, whatsappUrl } from '../data/site';
---

<section id={pricing.id} class="section section--block" aria-labelledby="tarifas-title">
  <div class="container pricing">
    <div class="section__head">
      <p class="eyebrow">{pricing.eyebrow}</p>
      <h2 id="tarifas-title" class="section__title">{pricing.title}</h2>
    </div>

    <div class="pricing__panel">
      <table class="pricing__table">
        <caption class="visually-hidden">{pricing.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{pricing.columns.service}</th>
            <th scope="col" class="pricing__price">{pricing.columns.price}</th>
          </tr>
        </thead>
        <tbody>
          {
            pricing.items.map((item) => (
              <tr class:list={{ 'is-highlight': item.highlight }}>
                <th scope="row">
                  <span class="pricing__name">{item.name}</span>
                  <span class="pricing__detail">{item.detail}</span>
                </th>
                <td class="pricing__price">{item.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="pricing__vat">{pricing.vatNote}</p>
    </div>

    <p class="pricing__insurance">
      <strong>{pricing.insurance.text}</strong>
      <a
        class="text-link"
        href={whatsappUrl(pricing.insurance.whatsappReason)}
        target="_blank"
        rel="noopener"
        aria-label={`${pricing.insurance.linkLabel} ${ui.whatsappLabel} ${ui.newTab}`}
      >
        {pricing.insurance.linkLabel}
        <Icon name="whatsapp" size={18} />
      </a>
    </p>
  </div>
</section>

<style>
  .pricing__panel {
    max-width: 48rem;
    padding: var(--space-xs) var(--space-lg) var(--space-md);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .pricing__table {
    width: 100%;
    border-collapse: collapse;
  }

  .pricing__table th,
  .pricing__table td {
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .pricing__table thead th {
    padding-block: var(--space-sm);
    border-bottom: 2px solid var(--color-text);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pricing__name {
    display: block;
    font-weight: 700;
  }

  .pricing__detail {
    display: block;
    margin-top: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .pricing__table .pricing__price {
    padding-left: var(--space-md);
    text-align: right;
    white-space: nowrap;
  }

  .pricing__table td.pricing__price {
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .is-highlight .pricing__name {
    color: var(--color-accent-strong);
  }

  .pricing__vat {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .pricing__insurance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-xs);
    margin-top: var(--space-lg);
  }

  /* En línea para que el icono acompañe al texto cuando este salta de línea. */
  .pricing__insurance .text-link {
    display: inline;
    line-height: 2;
  }

  .pricing__insurance .text-link :global(svg) {
    display: inline-block;
    margin-left: var(--space-2xs);
    vertical-align: -0.2em;
  }
</style>
