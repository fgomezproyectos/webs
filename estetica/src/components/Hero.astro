---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { hero, ui, whatsappUrl } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={hero.image.src}
      alt={hero.image.alt}
      formats={['avif', 'webp']}
      widths={[480, 768, 1080, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero__image"
    />
  </div>
  <div class="container hero__content">
    <h1 id="hero-title">{hero.title}</h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a class="button" href={whatsappUrl()} target="_blank" rel="noopener" aria-label={`${hero.primaryCta}: ${ui.bookAria} ${ui.newTab}`}>
        <Icon name="whatsapp" />
        {hero.primaryCta}
      </a>
      <a class="button button--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
  }

  .hero__media {
    order: 2;
    padding-inline: var(--gutter);
  }

  .hero__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .hero__content {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__subtitle {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 29.99rem) {
    .hero__actions .button {
      flex: 1 1 100%;
    }
  }

  /* Escritorio: foto a sangre con el texto sobre la zona clara. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-areas: 'stack';
      min-height: min(48rem, calc(100svh - var(--header-height)));
    }

    .hero__media,
    .hero__content {
      grid-area: stack;
    }

    .hero__media {
      position: relative;
      padding: 0;
    }

    .hero__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgb(250 247 242 / 0.96) 0%, rgb(250 247 242 / 0.85) 38%, rgb(250 247 242 / 0) 66%);
    }

    .hero__media :global(picture),
    .hero__image {
      height: 100%;
    }

    .hero__image {
      aspect-ratio: auto;
      border-radius: 0;
    }

    .hero__content {
      position: relative;
      z-index: 1;
      align-content: center;
      padding-block: var(--space-3xl);
    }

    .hero__content > * {
      max-width: 34rem;
    }
  }
</style>
